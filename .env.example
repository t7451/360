# FORGE3D Studio — Environment Configuration
# Copy to .env and fill in your values
# For Railway: set these in your service Variables panel

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Firebase Admin (Server-side token verification) ──────────────────────────
# Project: dforge-c8c59
# SETUP STEPS:
#   1. Go to: https://console.firebase.google.com/project/dforge-c8c59/settings/serviceaccounts/adminsdk
#   2. Click "Generate new private key" → download JSON
#   3. For Railway: paste the ENTIRE JSON content as the value of GOOGLE_APPLICATION_CREDENTIALS_JSON
#   4. For local dev: set GOOGLE_APPLICATION_CREDENTIALS to the file path instead
#
# RAILWAY (production) — paste full JSON as single env var:
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# LOCAL DEV — path to downloaded JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/dforge-c8c59-firebase-adminsdk.json
FIREBASE_PROJECT_ID=dforge-c8c59

# ── Stripe (Payments) ────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# https://dashboard.stripe.com/webhooks → Add endpoint → /api/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Redis (Job Queue) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Anthropic (Claude API for script generation) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Google Cloud Storage (Asset Delivery) ────────────────────────────────────
GCS_BUCKET=forge3d-assets
GCS_PROJECT_ID=dforge-c8c59
GCS_CDN_URL=https://storage.googleapis.com/forge3d-assets

# ── Blender MCP Bridge ───────────────────────────────────────────────────────
BLENDER_PATH=/usr/bin/blender
MCP_SERVER_URL=http://localhost:8765
MCP_PORT=8765
OUTPUT_DIR=./output

# ── Notifications ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
