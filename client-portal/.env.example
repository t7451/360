# FORGE3D Client Portal — Environment Variables
# Copy to .env.local for local dev
# For Netlify: add these in Site Settings > Environment Variables

# ── Firebase (Client SDK) ────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app
# Project: dforge-c8c59  |  https://console.firebase.google.com/project/dforge-c8c59
#
# SETUP STEPS:
#   1. Go to Firebase Console → Add app → Web (</>)
#   2. Register app name "FORGE3D Portal" — copy the firebaseConfig values below
#   3. Go to Authentication → Get started → Enable Email/Password provider
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dforge-c8c59.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dforge-c8c59

# ── API ──────────────────────────────────────────────────────────────────────
# Leave blank for local dev (Netlify proxy handles /api/* in production)
# Set to your Railway URL for direct calls: https://your-service.up.railway.app
VITE_API_URL=

# ── Cross-product links ──────────────────────────────────────────────────────
VITE_INKVAULT_URL=https://inkvault.netlify.app
